# --- Core ---------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/tournament-engine?retryWrites=true&w=majority

# --- Auth (Phase 1) -----------------------------------------------------
# Required. The server refuses to start without it, because a default signing
# secret would make every token forgeable. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# Used in invite emails to link players to the login page.
CLIENT_URL=http://localhost:5173

# --- Email (Phase 3) ----------------------------------------------------
# Optional. Without these the app runs normally and logs what it would have
# sent; in-app notifications are still recorded either way.
# For Gmail use smtp.gmail.com / 465 and an App Password, not your account
# password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- AI admin commands (Phase 4) ---------------------------------------
# Optional. Without it the natural-language command endpoint reports that the
# feature is unavailable; every other endpoint is unaffected.
ANTHROPIC_API_KEY=
